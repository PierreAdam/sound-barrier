{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "${workspaceFolder}/backend/.venv/Scripts/sound-barrier.exe",
      "runtimeArgs": ["serve", "--port", "4040"],
