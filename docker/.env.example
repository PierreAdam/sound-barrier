# Copy to .env next to docker-compose.yml and adapt. Paths are on the Docker host.
POSTGRES_PASSWORD=change-me
MUSIC_DIR=/srv/music
IMPORT_DIR=/srv/downloads
# Image version (Docker Hub tags: latest, 1.0.0...).
# SOUND_BARRIER_VERSION=1.0.0
# Optional: podcasts and audiobooks (turn them on in Settings → Library).
# PODCASTS_DIR=/srv/podcasts
# AUDIOBOOKS_DIR=/srv/audiobooks
# BEETS_DIR=./beets
# DATA_DIR=./data
# POSTGRES_DIR=./postgres
# Owner of the music files (`id -u` / `id -g`).
PUID=1000
PGID=1000
TZ=Europe/Paris
# PORT=4040
# FORWARDED_ALLOW_IPS=*
