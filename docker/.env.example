# Copy to .env next to docker-compose.yml and adapt. Paths are on the Docker host.
POSTGRES_PASSWORD=change-me
MUSIC_DIR=/srv/music
IMPORT_DIR=/srv/downloads
# Image version (Docker Hub tags: latest, 2.0.0...).
# SOUND_BARRIER_VERSION=2.0.0
# Optional: podcasts and audiobooks (turn them on in Settings → Library).
# PODCASTS_DIR=/srv/podcasts
# AUDIOBOOKS_DIR=/srv/audiobooks
# BEETS_DIR=./beets
# DATA_DIR=./data
# POSTGRES_DIR=./postgres
# Owner of the music files (`id -u` / `id -g`).
PUID=1000
PGID=1000
TZ=Europe/Paris
# PORT=4040
# Behind a reverse proxy, with the port published on 127.0.0.1 only (docker-compose.yml):
# trust its X-Forwarded-* headers. It must also forward the WebSocket /api/remote/ws
# (remote control; README, "Behind a reverse proxy").
# FORWARDED_ALLOW_IPS=*
