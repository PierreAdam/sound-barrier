# Copy to .env and adjust.

# Matches docker-compose.yml (local development only).
SOUND_BARRIER_DATABASE_URL=postgresql+asyncpg://soundbarrier:soundbarrier@localhost:5432/soundbarrier

# Key used to encrypt user passwords (required by Subsonic token auth).
# Generate one with: sound-barrier gen-secret
# Losing it means every user password must be reset.
SOUND_BARRIER_SECRET_KEY=

# Where caches (resized cover art, ...) are stored.
SOUND_BARRIER_DATA_DIR=./data

SOUND_BARRIER_LOG_LEVEL=info

# Automatic scans (at startup and daily). Their time is set in the web UI (Settings);
# it is the server's local time (in Docker, set TZ, e.g. TZ=Europe/Paris).
# false disables automatic scans entirely.
SOUND_BARRIER_SCHEDULER=true

# Files read in parallel during a scan. Raise it (e.g. 16) when the music is on a
# network drive: reading is then limited by latency, not by the CPU.
SOUND_BARRIER_SCAN_WORKERS=4
