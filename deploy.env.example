# Settings of ./deploy.sh. Copy to deploy.env (not committed) and adapt.
IMAGE=dockerhub-user/sound-barrier
SSH_HOST=user@server.example.com
SSH_PORT=22
# Folder of the docker-compose.yml on the server, and the application service in it.
REMOTE_DIR=/srv/docker/config/sound-barrier
SERVICE=app
# Public address, checked after the deployment (optional).
PUBLIC_URL=https://music.example.com
